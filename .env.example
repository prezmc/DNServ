# Copy this file to .env (next to docker-compose.yml) and change only what
# you need. Lines starting with # are ignored. After a change, run:
#   docker compose up -d

# Your time zone, used by group schedules.
TZ=America/Chicago

# Something else on this server already uses port 443 (a web server or
# reverse proxy, say)? Pick another port. The dashboard is then at
# https://<name>:8443/, or always at https://<name>:8080/ once HTTPS is on.
#DNSERV_HTTPS_PORT=8443

# The dashboard's plain port (also does HTTPS once it's turned on).
#DNSERV_WEB_PORT=8080

# The port other DNServ servers use to reach this one. If you change it,
# also set DNSERV_CLUSTER_ADVERTISE to this server's address and the new
# port, so the others know where to find it.
#DNSERV_CLUSTER_PORT=8091
#DNSERV_CLUSTER_ADVERTISE=192.168.1.10:8091
